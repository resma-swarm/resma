# RESMA — Environment Variables Example
#
# Copie este arquivo para .env e ajuste os valores.
# NUNCA commitar .env com secrets reais.
#
# Gerar JWT secret:
#   openssl rand -base64 32
#   ou
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Ambiente ---
# "production" ativa validações de segurança estritas (JWT secret, etc.)
RESMA_ENV=dev

# --- Database ---
RESMA_DB_PATH=/data/resma.duckdb

# --- HTTP Server ---
RESMA_HTTP_ADDR=:8080

# --- Auth / JWT ---
# OBRIGATÓRIO em produção. Gerar com: openssl rand -base64 32
RESMA_JWT_SECRET=dev-secret-change-me
# Alternativa: ler secret de arquivo (Docker Swarm secrets)
# RESMA_JWT_SECRET_FILE=/run/secrets/resma_jwt_secret
RESMA_JWT_ACCESS_TTL_MINUTES=15
RESMA_JWT_REFRESH_TTL_DAYS=7
RESMA_BCRYPT_COST=12
RESMA_LOGIN_RATE_LIMIT=5

# --- Admin ---
# Se vazio, senha aleatória é gerada e logada no startup
RESMA_DEFAULT_ADMIN_PASSWORD=

# --- CORS ---
# CSV de origens permitidas. NUNCA usar "*" em produção com credentials.
RESMA_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- API Keys ---
RESMA_API_KEY_DEFAULT_SCOPES=read
RESMA_API_KEY_RATE_LIMIT=100

# --- Collector ---
# Defaults de produção (alinhados aos benchmarks Prometheus/Grafana).
# Para dev com coleta mais rápida, sobrescreva aqui (ex: RESMA_COLLECT_INTERVAL=5).
RESMA_COLLECT_INTERVAL=15
RESMA_RETENTION_DAYS=30
RESMA_CLUSTER_INTERVAL=30
RESMA_STORAGE_INTERVAL=60
RESMA_EXCLUDED_IMAGES=resma-api:latest,resma-ml:latest

# --- Cadências internas (tornar hardcoded configuráveis) ---
RESMA_SCHEDULER_POLL=15
RESMA_SSE_KEEPALIVE=15

# --- ML Analysis ---
RESMA_ANALYSIS_WINDOW_DAYS=7
RESMA_OUTLIER_THRESHOLD=3.0
RESMA_LEAK_R2_THRESHOLD=0.7
RESMA_LEAK_DAILY_MB_THRESHOLD=10.0

# --- ML Sidecar ---
RESMA_ML_URL=http://resma-ml:8081
RESMA_ML_ENABLED=true
